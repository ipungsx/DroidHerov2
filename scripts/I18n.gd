func init_from_settings(saved_lang: String) -> void:
	if saved_lang == "en" or saved_lang == "id":
		current_lang = saved_lang
	else:
		var sys := OS.get_locale_language().to_lower()
		current_lang = "id" if (sys == "id" or sys == "in") else "en"

func set_language(lang_code: String) -> void:
	var target := "id" if lang_code == "id" else "en"
	if current_lang != target:
		current_lang = target
		GameState.settings["language"] = target
		GameState.save_data()
		language_changed.emit(target)

func toggle_language() -> void:
	set_language("id" if current_lang == "en" else "en")

func t(key: String) -> String:
	var table: Dictionary = STRINGS.get(current_lang, STRINGS["en"])
	if table.has(key):
		return str(table[key])
	return str(STRINGS["en"].get(key, key))
